{
  "name": "engagements",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fanzone": "vite --config vite.config.fanzone.js",
    "build": "vite build",
    "build:fanzone": "vite build --config vite.config.fanzone.js && node -e \"import('node:fs').then(fs => fs.copyFileSync('dist-fanzone/fanzone.html', 'dist-fanzone/index.html'))\"",
