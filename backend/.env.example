# Local development: leave DATABASE_URL unset to use a local SQLite file
# (backend/engagements.db). On Vercel or any serverless host, DATABASE_URL
# is required — see backend/README.md for details.
# DATABASE_URL=postgresql://username:password@localhost:5432/fanforge

# Secret used to sign JWT access tokens. Required in production — without it,
# the backend falls back to an insecure, publicly-known dev default and prints
# a startup warning. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
